# ===== تنظیمات ربات بله =====
BALE_BOT_TOKEN=your_bale_bot_token_here

# ===== تنظیمات سرور =====
PORT=3000

# ===== پنل ادمین =====
ADMIN_PASSWORD=Tk_tokyo
ADMIN_PATH=/panel-Tk_tokyo

# ===== احراز هویت =====
OTP_EXPIRE=120

# ===== API بله =====
BALE_API=https://tapi.bale.ai/bot

# ===== آپلود فایل =====
# حداکثر سایز فایل آپلود به بایت (50MB)
MAX_FILE_SIZE=52428800

# ===== دیتابیس PostgreSQL =====
# در Render.com این متغیر خودکار اضافه می‌شود
DATABASE_URL=postgresql://user:password@host:5432/dbname
